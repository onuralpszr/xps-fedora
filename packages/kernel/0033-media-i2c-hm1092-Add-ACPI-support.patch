From: Onuralp SEZER <thunderbirdtr@fedoraproject.org>
Subject: [PATCH] media: i2c: hm1092: Add ACPI support

On Intel laptops (Dell XPS 14/16 DA14260/DA16260, Panther Lake + IPU7) the
HM1092 IR sensor is enumerated by ACPI as HIMX1092, and its fwnode graph
endpoint is created by ipu-bridge when the IPU ISYS probes.

Match the HIMX1092 ACPI HID and defer probing until the bridge has added
the endpoint, the same way ov08x40 and other IPU sensors do. Without the
deferral the sensor fails permanently with "parsing endpoint failed" when
it probes before the IPU driver.

Not yet upstream; applies on top of "[PATCH v6 2/2] media: i2c: hm1092:
add Himax HM1092 mono NIR sensor driver".
---
diff --git a/drivers/media/i2c/hm1092.c b/drivers/media/i2c/hm1092.c
index eb3607a..18ebed7 100644
--- a/drivers/media/i2c/hm1092.c
+++ b/drivers/media/i2c/hm1092.c
@@ -5,6 +5,7 @@
  * Copyright (c) 2026 Ramshouriesh R <rshouriesh@gmail.com>
  */
 
+#include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
@@ -649,7 +650,15 @@ static int hm1092_check_hwcfg(struct hm1092 *hm1092)
 	unsigned long link_freq_bitmap;
 	int ret;
 
+	/*
+	 * On ACPI systems the fwnode graph is created by the IPU bridge driver,
+	 * which also adds the sensor properties. Wait for it.
+	 */
 	ep = fwnode_graph_get_endpoint_by_id(fwnode, 0, 0, 0);
+	if (!ep)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "waiting for fwnode graph endpoint\n");
+
 	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
 	fwnode_handle_put(ep);
 	if (ret)
@@ -841,6 +850,14 @@ err_ctrls:
 static DEFINE_RUNTIME_DEV_PM_OPS(hm1092_pm_ops, hm1092_power_off,
 				 hm1092_power_on, NULL);
 
+#ifdef CONFIG_ACPI
+static const struct acpi_device_id hm1092_acpi_ids[] = {
+	{ "HIMX1092" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(acpi, hm1092_acpi_ids);
+#endif
+
 static const struct of_device_id hm1092_of_match[] = {
 	{ .compatible = "himax,hm1092" },
 	{ /* sentinel */ }
@@ -851,6 +868,7 @@ static struct i2c_driver hm1092_i2c_driver = {
 	.driver = {
 		.name = "hm1092",
 		.pm = pm_ptr(&hm1092_pm_ops),
+		.acpi_match_table = ACPI_PTR(hm1092_acpi_ids),
 		.of_match_table = hm1092_of_match,
 	},
 	.probe = hm1092_probe,
