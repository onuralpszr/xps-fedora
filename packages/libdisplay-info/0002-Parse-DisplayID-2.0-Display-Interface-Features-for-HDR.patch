+		ssc->bt2020_rgb = cm->bt2020_rgb;
+		ssc->st2113_rgb = cm->st2113_rgb;
+		ssc->ictcp = cm->ictcp;
 		return;
+	}
 
-	cm = di_cta_data_block_get_colorimetry(block);
-	assert(cm);
+	/* Fallback to DisplayID 2.0 Display Interface Features */
+	features = edid_get_displayid2_display_interface_features(edid);
+	if (features == NULL) {
+		return;
+	}
 
-	ssc->bt2020_cycc = cm->bt2020_cycc;
-	ssc->bt2020_ycc = cm->bt2020_ycc;
-	ssc->bt2020_rgb = cm->bt2020_rgb;
-	ssc->st2113_rgb = cm->st2113_rgb;
-	ssc->ictcp = cm->ictcp;
+	for (idx = 0; idx < features->combinations_len; idx++) {
+		c = &features->combinations[idx];
+		if (c->color_space == DI_DISPLAYID2_INTERFACE_COLOR_SPACE_DCI_P3
