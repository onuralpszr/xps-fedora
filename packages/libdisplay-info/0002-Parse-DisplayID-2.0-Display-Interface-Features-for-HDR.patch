+		if (c->color_space
+		    == DI_DISPLAYID2_INTERFACE_COLOR_SPACE_BT2020) {
+			ssc->bt2020_rgb = true;
+			ssc->bt2020_ycc = true;
+		}
+	}
 }
 
 struct di_info *
