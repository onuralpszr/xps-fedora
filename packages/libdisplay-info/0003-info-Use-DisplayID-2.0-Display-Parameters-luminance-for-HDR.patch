From: Onuralp SEZER <thunderbirdtr@fedoraproject.org>
Date: Fri, 16 Oct 2026 00:00:00 +0300
Subject: [PATCH] info: Use DisplayID 2.0 Display Parameters luminance for HDR
 metadata

Panels that declare HDR only through DisplayID 2.0 also carry their native
luminance in the Display Parameters Data Block (tag 0x21): maximum with full
coverage, maximum with 10% rectangular coverage and minimum, as IEEE 754
half floats. Parse them and, when the Display Interface Features block
reports BT.2020 with SMPTE ST 2084, use them as the HDR static metadata
luminance: the 10% window maximum as the peak, the full coverage maximum as
the frame average.

Without this the compositor gets no luminance and has to guess the peak.
On the LG OLED of the Dell XPS 16 DA16260 (LGD 0x1989) this gives 525,
400 and 0.0005 cd/m².

Signed-off-by: Onuralp SEZER <thunderbirdtr@fedoraproject.org>
---
diff --git a/displayid2.c b/displayid2.c
index 939315e..6a33671 100644
--- a/displayid2.c
+++ b/displayid2.c
@@ -1,5 +1,6 @@
 #include <errno.h>
 #include <inttypes.h>
+#include <math.h>
 #include <stdlib.h>
 #include <sys/types.h>
 
@@ -67,6 +68,48 @@ static const struct di_displayid2_color_space_eotf_map std_combos[] = {
 
 #define NUM_STD_COMBOS (sizeof(std_combos) / sizeof(std_combos[0]))
 
+/* IEEE 754 binary16, little endian */
+static float
+decode_half_float(const uint8_t *data)
+{
+	uint16_t raw = (uint16_t)(data[0] | (data[1] << 8));
+	int exponent = get_bit_range(data[1], 6, 2);
+	int mantissa = raw & 0x3FF;
+	float value;
+
+	if (exponent == 0) {
+		value = ldexpf((float)mantissa, -24);
+	} else if (exponent == 0x1F) {
+		return 0;
+	} else {
+		value = ldexpf((float)(mantissa | 0x400), exponent - 25);
+	}
+	return has_bit(data[1], 7) ? -value : value;
+}
+
+static bool
+parse_display_params_block(struct di_displayid2 *displayid2,
+			   struct di_displayid2_data_block *data_block,
+			   const uint8_t *data, size_t size)
+{
+	struct di_displayid2_display_params *params = &data_block->display_params;
+	const uint8_t *payload = &data[DISPLAYID2_DATA_BLOCK_HEADER_SIZE];
+	size_t payload_len = size - DISPLAYID2_DATA_BLOCK_HEADER_SIZE;
+
+	if (payload_len < 27) {
+		add_failure(displayid2,
+			    "Display Parameters Data Block payload length (%zu) is too small",
+			    payload_len);
+		return true;
+	}
+
+	params->max_luminance_full = decode_half_float(&payload[21]);
+	params->max_luminance_10_percent = decode_half_float(&payload[23]);
+	params->min_luminance = decode_half_float(&payload[25]);
+
+	return true;
+}
+
 static bool
 parse_display_interface_features_block(
 	struct di_displayid2 *displayid2,
@@ -210,8 +253,13 @@ parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 			goto error;
 		}
 		break;
-	case DI_DISPLAYID2_DATA_BLOCK_PRODUCT_ID:
 	case DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS:
+		if (!parse_display_params_block(displayid2, data_block, data,
+						data_block_size)) {
+			goto error;
+		}
+		break;
+	case DI_DISPLAYID2_DATA_BLOCK_PRODUCT_ID:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_VII_TIMING:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_VIII_TIMING:
 	case DI_DISPLAYID2_DATA_BLOCK_TYPE_IX_TIMING:
@@ -416,3 +464,13 @@ di_displayid2_data_block_get_display_interface_features(
 	}
 	return &data_block->features;
 }
+
+const struct di_displayid2_display_params *
+di_displayid2_data_block_get_display_params(
+	const struct di_displayid2_data_block *data_block)
+{
+	if (data_block->tag != DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS) {
+		return NULL;
+	}
+	return &data_block->display_params;
+}
diff --git a/include/displayid2.h b/include/displayid2.h
index bd2f347..da9f760 100644
--- a/include/displayid2.h
+++ b/include/displayid2.h
@@ -37,6 +37,9 @@ struct di_displayid2_data_block {
 
 	/* Used for DI_DISPLAYID2_DATA_BLOCK_DISPLAY_INTERFACE_FEATURES */
 	struct di_displayid2_display_interface_features features;
+
+	/* Used for DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS */
+	struct di_displayid2_display_params display_params;
 };
 
 bool
diff --git a/include/libdisplay-info/displayid2.h b/include/libdisplay-info/displayid2.h
index e56e92f..9710ce7 100644
--- a/include/libdisplay-info/displayid2.h
+++ b/include/libdisplay-info/displayid2.h
@@ -188,4 +188,29 @@ const struct di_displayid2_display_interface_features *
 di_displayid2_data_block_get_display_interface_features(
 	const struct di_displayid2_data_block *data_block);
 
+/**
+ * Display Parameters Data Block, defined in section 4.2.
+ *
+ * Only the native luminance fields are exposed.
+ */
+struct di_displayid2_display_params {
+	/* Native maximum luminance with full coverage (cd/m²), zero if unset */
+	float max_luminance_full;
+	/* Native maximum luminance with 10% rectangular coverage (cd/m²),
+	 * zero if unset */
+	float max_luminance_10_percent;
+	/* Native minimum luminance (cd/m²), zero if unset */
+	float min_luminance;
+};
+
+/**
+ * Get the Display Parameters from a DisplayID v2 data block.
+ *
+ * Returns NULL if the data block tag isn't
+ * DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS.
+ */
+const struct di_displayid2_display_params *
+di_displayid2_data_block_get_display_params(
+	const struct di_displayid2_data_block *data_block);
+
 #endif
diff --git a/info.c b/info.c
index 9f307e5..311bf6d 100644
--- a/info.c
+++ b/info.c
@@ -109,6 +109,32 @@ edid_get_displayid2_display_interface_features(const struct di_edid *edid)
 	return NULL;
 }
 
+static const struct di_displayid2_display_params *
+edid_get_displayid2_display_params(const struct di_edid *edid)
+{
+	const struct di_edid_ext *const *ext;
+	const struct di_displayid2 *displayid2;
+	const struct di_displayid2_data_block *block;
+
+	for (ext = di_edid_get_extensions(edid); *ext; ext++) {
+		if (di_edid_ext_get_tag(*ext) != DI_EDID_EXT_DISPLAYID) {
+			continue;
+		}
+
+		displayid2 = di_edid_ext_get_displayid2(*ext);
+		if (displayid2 == NULL) {
+			continue;
+		}
+
+		block = displayid2_get_data_block(
+			displayid2, DI_DISPLAYID2_DATA_BLOCK_DISPLAY_PARAMS);
+		if (block != NULL) {
+			return di_displayid2_data_block_get_display_params(block);
+		}
+	}
+	return NULL;
+}
+
 static void
 derive_edid_hdr_static_metadata(const struct di_edid *edid,
 				struct di_hdr_static_metadata *hsm)
@@ -117,6 +143,7 @@ derive_edid_hdr_static_metadata(const struct di_edid *edid,
 	const struct di_cta_hdr_static_metadata_block *cta_hsm;
 	const struct di_displayid2_display_interface_features *features;
 	const struct di_displayid2_color_space_eotf_map *c;
+	const struct di_displayid2_display_params *params;
 	size_t idx;
 
 	/* By default, everything unset and only traditional gamma supported. */
@@ -155,6 +182,21 @@ derive_edid_hdr_static_metadata(const struct di_edid *edid,
 		}
 		if (c->eotf == DI_DISPLAYID2_INTERFACE_EOTF_SMPTE_ST2084) {
 			hsm->pq = true;
+			/* The panel's native luminance from the DisplayID 2.0
+			 * Display Parameters stands in for the CTA-861 desired
+			 * content luminance: the 10% window maximum is the
+			 * peak, the full coverage maximum the frame average. */
+			params = edid_get_displayid2_display_params(edid);
+			if (params != NULL) {
+				hsm->desired_content_max_luminance =
+					params->max_luminance_10_percent > 0 ?
+					params->max_luminance_10_percent :
+					params->max_luminance_full;
+				hsm->desired_content_max_frame_avg_luminance =
+					params->max_luminance_full;
+				hsm->desired_content_min_luminance =
+					params->min_luminance;
+			}
 		}
 		if (c->eotf == DI_DISPLAYID2_INTERFACE_EOTF_HLG) {
 			hsm->hlg = true;
