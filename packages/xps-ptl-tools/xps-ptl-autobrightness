#!/usr/bin/python3
"""Ambient-light auto-brightness for KDE Plasma (Wayland).

Reads the ambient light sensor through iio-sensor-proxy (system bus) and sets
the internal display's brightness through KDE's org.kde.ScreenBrightness
(session bus). PowerDevil 6.x has no ambient-light support of its own.

Behaviour:
- brightness follows a log-lux curve (eyes perceive light logarithmically);
- spike-proof lux: the sensor reports bursts of impossible values (up to
  ~115 000 lx for 0.5-1.5 s in a dark room on the XPS 16), so readings are
  sampled every 0.5 s, capped, and reduced to a low percentile of the last
  few seconds before smoothing;
- hysteresis and short fades instead of jumps;
- a manual change (one that held for `learn_after` seconds) becomes an offset
  on top of the curve instead of being overwritten;
- a sharp drop (KDE idle dimming) pauses adjusting until brightness is
  restored; nothing is learned from it.

Config: /etc/xps-ptl/autobrightness.conf, overridden by
~/.config/xps-ptl/autobrightness.conf ([autobrightness] section).
State (on/off, OSD, learned offset): ~/.local/state/xps-ptl/autobrightness.

D-Bus (session): org.xpsptl.AutoBrightness at /org/xpsptl/AutoBrightness
  properties: Enabled (b, rw), Osd (b, rw), Lux (d), Brightness (d, %),
              Offset (d, %), Target (d, %), Paused (b)
  methods:    SetEnabled(b), SetOsd(b), SetOffset(d), ResetOffset(),
              Enable(), Disable(), ToggleOsd()
Used by the "Auto Brightness" Plasma widget.
"""
import collections
import configparser
import math
import os
import sys
import time

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

SENSOR_BUS = "net.hadess.SensorProxy"
SENSOR_PATH = "/net/hadess/SensorProxy"
BRIGHT_BUS = "org.kde.ScreenBrightness"
BRIGHT_PATH = "/org/kde/ScreenBrightness"
DISPLAY_IFACE = "org.kde.ScreenBrightness.Display"
SUPPRESS_INDICATOR = 0x1  # no OSD for our own changes
SERVICE = "org.xpsptl.AutoBrightness"
SERVICE_PATH = "/org/xpsptl/AutoBrightness"
STATE_FILE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                          "xps-ptl", "autobrightness")

DEFAULTS = {
    # "lux:percent" points, interpolated on log10(lux + 1)
    "curve": "0:8 10:25 100:45 1000:75 10000:100",
    "min_percent": "5",
    "max_percent": "100",
    "hysteresis_percent": "4",
    "smoothing": "0.3",        # EMA weight per 2 s control step
    "window_seconds": "6",     # spike filter window
    "percentile": "30",        # low percentile of the window (spikes only go up)
    "max_lux": "40000",        # readings above this are sensor glitches
    "fade_ms": "800",
    "learn_after": "10",       # seconds a manual change must hold
    "dim_ratio": "0.5",        # drop to <= this fraction = idle dimming
    "debug": "false",
}


def load_config():
    cp = configparser.ConfigParser()
    cp.read_dict({"autobrightness": DEFAULTS})
    cp.read(["/etc/xps-ptl/autobrightness.conf",
             os.path.expanduser("~/.config/xps-ptl/autobrightness.conf")])
    c = cp["autobrightness"]
    curve = []
    for point in c["curve"].split():
        lux, pct = point.split(":")
        curve.append((math.log10(float(lux) + 1), float(pct)))
    return {
        "curve": sorted(curve),
        "min": c.getfloat("min_percent"),
        "max": c.getfloat("max_percent"),
        "hyst": c.getfloat("hysteresis_percent"),
        "alpha": c.getfloat("smoothing"),
        "window": max(1, int(c.getfloat("window_seconds") * 2)),  # 0.5 s samples
        "percentile": c.getfloat("percentile"),
        "max_lux": c.getfloat("max_lux"),
        "fade_ms": c.getint("fade_ms"),
        "learn_after": c.getfloat("learn_after"),
        "dim_ratio": c.getfloat("dim_ratio"),
        "debug": c.getboolean("debug"),
    }


class AutoBrightness:
    def __init__(self, cfg):
        self.cfg = cfg
        self.sysbus = dbus.SystemBus()
        self.sesbus = dbus.SessionBus()
        self.lux = None
        state = self.load_state()
        self.offset = state["offset"]     # learned user offset, percent
        self.enabled = state["enabled"]
        self.osd = state["osd"]
        self.service = None
        self.ours = []             # (value, time) we set recently
        self.fade_id = 0
        self.paused_for = None     # brightness to wait for (idle dim)
        self.pending = None        # (value, since) unexplained change
        self.display = None
        self.max_raw = 10000
        self.last_seen = None      # last known brightness (ours or not)
        self.sensor = None
        self.started = False
        self.samples = collections.deque(maxlen=cfg["window"])
        self.raw_lux = 0.0

        self.sysbus.add_signal_receiver(self.on_sensor_props, "PropertiesChanged",
                                        "org.freedesktop.DBus.Properties",
                                        SENSOR_BUS, SENSOR_PATH)
        self.sysbus.add_signal_receiver(self.on_owner, "NameOwnerChanged",
                                        "org.freedesktop.DBus", arg0=SENSOR_BUS)
        self.sesbus.add_signal_receiver(self.on_owner, "NameOwnerChanged",
                                        "org.freedesktop.DBus", arg0=BRIGHT_BUS)
        self.claim()
        self.find_display()
        GLib.timeout_add(500, self.sample)
        GLib.timeout_add_seconds(2, self.tick)

    def load_state(self):
        state = {"offset": 0.0, "enabled": True, "osd": False}
        try:
            text = open(STATE_FILE).read()
        except OSError:
            return state
        try:  # first version stored just the offset
            state["offset"] = float(text.strip())
            return state
        except ValueError:
            pass
        cp = configparser.ConfigParser()
        cp.read_string(text)
        if cp.has_section("state"):
            st = cp["state"]
            state["offset"] = st.getfloat("offset", 0.0)
            state["enabled"] = st.getboolean("enabled", True)
            state["osd"] = st.getboolean("osd", False)
        return state

    def save_state(self):
        try:
            os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
            with open(STATE_FILE, "w") as f:
                f.write(f"[state]\noffset = {self.offset:.2f}\n"
                        f"enabled = {str(self.enabled).lower()}\n"
                        f"osd = {str(self.osd).lower()}\n")
        except OSError as e:
            self.log("can't save state:", e)

    def notify(self):
        if self.service:
            self.service.notify()

    def brightness_percent(self):
        if self.last_seen is None:
            return 0.0
        return self.last_seen / self.max_raw * 100

    def set_enabled(self, on):
        self.enabled = bool(on)
        self.pending = None
        if not self.enabled:
            self.cancel_fade()
        self.save_state()
        self.log("enabled" if self.enabled else "disabled")
        self.notify()

    def set_osd(self, on):
        self.osd = bool(on)
        self.save_state()
        self.notify()

    def set_offset(self, value):
        """Preference from the widget's slider, in percent."""
        self.offset = max(-50.0, min(50.0, float(value)))
        self.pending = None
        self.save_state()
        self.log(f"offset set to {self.offset:+.1f}%")
        self.notify()

    def reset_offset(self):
        self.offset = 0.0
        self.pending = None
        self.save_state()
        self.log("offset reset")
        self.notify()

    def log(self, *a):
        if self.cfg["debug"]:
            print(time.strftime("%H:%M:%S"), *a, flush=True)

    # --- sensor ---------------------------------------------------------
    def claim(self):
        try:
            proxy = self.sysbus.get_object(SENSOR_BUS, SENSOR_PATH)
            props = dbus.Interface(proxy, "org.freedesktop.DBus.Properties")
            if not props.Get(SENSOR_BUS, "HasAmbientLight"):
                print("no ambient light sensor", file=sys.stderr)
                return
            dbus.Interface(proxy, SENSOR_BUS).ClaimLight()
            self.sensor = props
            first = float(props.Get(SENSOR_BUS, "LightLevel"))
            if first <= self.cfg["max_lux"]:
                self.samples.append(first)
            self.log("claimed light sensor, first reading", first)
        except dbus.DBusException as e:
            print("iio-sensor-proxy unavailable:", e, file=sys.stderr)

    def on_sensor_props(self, iface, changed, invalidated):
        # iio-sensor-proxy only signals changes, so a steady reading would
        # leave the smoothed value stuck; sample() polls on every tick instead.
        pass

    def sample(self):
        """Every 0.5 s: collect a raw reading, dropping impossible values."""
        if self.sensor is None:
            return True
        try:
            raw = float(self.sensor.Get(SENSOR_BUS, "LightLevel"))
        except dbus.DBusException as e:
            self.log("sensor read failed:", e)
            return True
        self.raw_lux = raw
        if raw <= self.cfg["max_lux"]:
            self.samples.append(raw)
        elif self.cfg["debug"]:
            self.log(f"dropped glitch reading {raw:.0f} lx")
        return True

    def filtered_lux(self):
        """Low percentile of the recent window: a short burst of high values
        can't move it, a real change does within a few seconds."""
        if not self.samples:
            return None
        vals = sorted(self.samples)
        idx = int(round((len(vals) - 1) * self.cfg["percentile"] / 100))
        return vals[idx]

    def update_lux(self):
        new = self.filtered_lux()
        if new is None:
            return
        a = self.cfg["alpha"]
        self.lux = new if self.lux is None else a * new + (1 - a) * self.lux

    def on_owner(self, name, old, new):
        if not new:
            return
        if name == SENSOR_BUS:
            self.claim()
        elif name == BRIGHT_BUS:
            self.find_display()

    # --- display --------------------------------------------------------
    def find_display(self):
        self.display = None
        try:
            root = self.sesbus.get_object(BRIGHT_BUS, BRIGHT_PATH)
            names = dbus.Interface(root, "org.freedesktop.DBus.Properties").Get(
                BRIGHT_BUS, "DisplaysDBusNames")
            for n in names:
                obj = self.sesbus.get_object(BRIGHT_BUS, f"{BRIGHT_PATH}/{n}")
                props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
                if props.Get(DISPLAY_IFACE, "IsInternal"):
                    self.display = obj
                    self.max_raw = int(props.Get(DISPLAY_IFACE, "MaxBrightness"))
                    self.sesbus.add_signal_receiver(
                        self.on_display_props, "PropertiesChanged",
                        "org.freedesktop.DBus.Properties", BRIGHT_BUS,
                        f"{BRIGHT_PATH}/{n}")
                    self.log("internal display:", n, "max", self.max_raw)
                    return
        except dbus.DBusException as e:
            print("KDE ScreenBrightness unavailable:", e, file=sys.stderr)

    def current_raw(self):
        props = dbus.Interface(self.display, "org.freedesktop.DBus.Properties")
        return int(props.Get(DISPLAY_IFACE, "Brightness"))

    def set_raw(self, value, final=False):
        value = int(round(value))
        self.last_seen = value
        self.ours.append((value, time.monotonic()))
        self.ours = self.ours[-64:]
        flags = 0 if (final and self.osd) else SUPPRESS_INDICATOR
        dbus.Interface(self.display, DISPLAY_IFACE).SetBrightness(
            dbus.Int32(value), dbus.UInt32(flags))

    def is_ours(self, value):
        now = time.monotonic()
        return any(abs(v - value) <= 2 and now - t < 3 for v, t in self.ours)

    def on_display_props(self, iface, changed, invalidated):
        if "Brightness" not in changed:
            return
        value = int(changed["Brightness"])
        if self.is_ours(value):
            return
        if self.last_seen is not None and abs(value - self.last_seen) <= 2:
            return  # KDE re-announces unchanged values; not a user change
        before, self.last_seen = self.last_seen, value
        self.notify()
        if not self.enabled:
            return
        if self.paused_for is not None:
            if value >= self.paused_for - 2:
                self.log("brightness restored, resuming")
                self.paused_for = None
            return
        if before and value <= before * self.cfg["dim_ratio"]:
            self.log("sharp drop", before, "->", value, ": idle dimming, pausing")
            self.cancel_fade()
            self.paused_for = before
            self.pending = None
            return
        self.cancel_fade()
        self.pending = (value, time.monotonic())

    # --- control loop ---------------------------------------------------
    def curve_percent(self):
        x = math.log10(max(self.lux, 0.0) + 1)
        pts = self.cfg["curve"]
        if x <= pts[0][0]:
            return pts[0][1]
        for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
            if x <= x1:
                return y0 + (y1 - y0) * (x - x0) / (x1 - x0)
        return pts[-1][1]

    def target_raw(self):
        pct = min(self.cfg["max"], max(self.cfg["min"], self.curve_percent() + self.offset))
        return pct / 100 * self.max_raw

    def tick(self):
        self.update_lux()
        self.notify()
        if (self.display is None or self.lux is None or self.paused_for is not None
                or not self.enabled):
            return True
        try:
            if not self.started:
                # Start from the curve plus the saved preference, not from
                # whatever brightness the session happened to be left at.
                self.last_seen = self.current_raw()
                self.started = True
                self.log(f"start: brightness {self.last_seen}, lux {self.lux:.0f}, saved offset {self.offset:+.1f}%")
            if self.pending:
                value, since = self.pending
                if time.monotonic() - since >= self.cfg["learn_after"]:
                    self.offset = value / self.max_raw * 100 - self.curve_percent()
                    self.save_state()
                    self.pending = None
                    self.log(f"learned offset {self.offset:+.1f}% (lux {self.lux:.0f})")
                return True
            cur = self.current_raw()
            target = self.target_raw()
            if abs(target - cur) / self.max_raw * 100 >= self.cfg["hyst"] and not self.fade_id:
                self.log(f"lux {self.lux:.0f}: {cur} -> {target:.0f}")
                self.fade(cur, target)
        except dbus.DBusException as e:
            self.log("dbus error:", e)
            self.find_display()
        return True

    def fade(self, start, end):
        steps = max(1, self.cfg["fade_ms"] // 50)
        state = {"i": 0}

        def step():
            state["i"] += 1
            last = state["i"] >= steps
            self.set_raw(start + (end - start) * state["i"] / steps, final=last)
            if last:
                self.fade_id = 0
                return False
            return True
        self.fade_id = GLib.timeout_add(50, step)

    def cancel_fade(self):
        if self.fade_id:
            GLib.source_remove(self.fade_id)
            self.fade_id = 0


class Service(dbus.service.Object):
    """org.xpsptl.AutoBrightness: state for the Plasma widget."""

    def __init__(self, ab):
        self.ab = ab
        self.last = {}
        name = dbus.service.BusName(SERVICE, ab.sesbus, do_not_queue=True)
        super().__init__(name, SERVICE_PATH)

    def props(self):
        ab = self.ab
        return {
            "Enabled": dbus.Boolean(ab.enabled),
            "Osd": dbus.Boolean(ab.osd),
            "Lux": dbus.Double(round(ab.lux or 0.0, 1)),
            "Brightness": dbus.Double(round(ab.brightness_percent(), 1)),
            "Offset": dbus.Double(round(ab.offset, 1)),
            "Paused": dbus.Boolean(ab.paused_for is not None),
            "Target": dbus.Double(round(ab.target_raw() / ab.max_raw * 100, 1)
                                  if ab.lux is not None else 0.0),
        }

    def notify(self):
        now = self.props()
        changed = {k: v for k, v in now.items() if self.last.get(k) != v}
        if changed:
            self.last = now
            self.PropertiesChanged(SERVICE, changed, [])

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, iface, prop):
        return self.props()[prop]

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, iface):
        return self.props()

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ssv")
    def Set(self, iface, prop, value):
        if prop == "Enabled":
            self.ab.set_enabled(value)
        elif prop == "Osd":
            self.ab.set_osd(value)
        else:
            raise dbus.exceptions.DBusException(
                f"{prop} is read-only", name="org.freedesktop.DBus.Error.PropertyReadOnly")

    @dbus.service.signal(dbus.PROPERTIES_IFACE, signature="sa{sv}as")
    def PropertiesChanged(self, iface, changed, invalidated):
        pass

    @dbus.service.method(SERVICE, in_signature="b")
    def SetEnabled(self, on):
        self.ab.set_enabled(on)

    @dbus.service.method(SERVICE, in_signature="b")
    def SetOsd(self, on):
        self.ab.set_osd(on)

    @dbus.service.method(SERVICE)
    def ResetOffset(self):
        self.ab.reset_offset()

    @dbus.service.method(SERVICE, in_signature="d")
    def SetOffset(self, value):
        self.ab.set_offset(value)

    # argument-free variants for QML (no typed D-Bus arguments needed)
    @dbus.service.method(SERVICE)
    def Enable(self):
        self.ab.set_enabled(True)

    @dbus.service.method(SERVICE)
    def Disable(self):
        self.ab.set_enabled(False)

    @dbus.service.method(SERVICE)
    def ToggleOsd(self):
        self.ab.set_osd(not self.ab.osd)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    cfg = load_config()
    if "--debug" in sys.argv:
        cfg["debug"] = True
    ab = AutoBrightness(cfg)
    try:
        ab.service = Service(ab)
    except dbus.exceptions.NameExistsException:
        print("another instance is running", file=sys.stderr)
        sys.exit(1)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
