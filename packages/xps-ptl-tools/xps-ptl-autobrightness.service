[Unit]
Description=Ambient-light auto-brightness (iio-sensor-proxy -> KDE ScreenBrightness)
Documentation=file:///usr/share/doc/xps-ptl-tools/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/xps-ptl-autobrightness
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
